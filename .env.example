# ── Database (Neon Postgres) ────────────────────────────────────────────
# Pooled connection — the app uses this at runtime.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Direct (unpooled) connection — Drizzle Kit uses this for `db:push` and Studio.
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Better Auth (the OIDC client runtime) ───────────────────────────────
# VOSS is the identity provider, but Better Auth still runs here as the relying
# party: it signs VERP's OWN session cookies and the PKCE/state cookies for the
# OAuth handshake. BETTER_AUTH_SECRET is REQUIRED — without it Better Auth cannot
# sign sessions and login breaks in production. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="generate-a-random-secret-here"
# VERP's own origin. Used to build the redirect URI you register with VOSS:
#   <BETTER_AUTH_URL>/api/auth/oauth2/callback/voss
BETTER_AUTH_URL="http://localhost:3000"

# ── VOSS Auth (accounts.vosslabs.org) ───────────────────────────────────
# VERP holds no credentials of its own. Register VERP as a client in the vauth
# repo; the client secret is hashed at rest there and shown exactly once.
VOSS_DISCOVERY_URL="https://accounts.vosslabs.org/api/auth/.well-known/openid-configuration"
VOSS_CLIENT_ID=""
VOSS_CLIENT_SECRET=""

# ── Bug reporting (optional) ────────────────────────────────────────────
# Base URL of the Worker in infrastructure/bug-report-worker, which holds the
# GitHub PAT and files the issue. Leave it unset and no bug button renders.
VERP_BUG_REPORT_URL=""
